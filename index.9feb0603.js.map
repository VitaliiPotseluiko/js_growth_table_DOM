"use strict";
var MIN_ROWS = 2;
var MAX_ROWS = 10;
var MAX_COLUMNS = 10;
var MIN_COLUMNS = 2;
var table = document.querySelector(".field");
var rows = table.rows;
var appendRowButton = document.querySelector(".append-row");
var removeRowButton = document.querySelector(".remove-row");
var appendColumnButton = document.querySelector(".append-column");
var removeColumnButton = document.querySelector(".remove-column");
appendRowButton.addEventListener("click", function() {
    if (rows.length < MAX_ROWS) {
        removeRowButton.disabled = false;
        var newRow = document.createElement("tr");
        for(var i = 0; i < rows[0].cells.length; i++){
            var td = document.createElement("td");
            newRow.append(td);
        }
        table.tBodies[0].append(newRow);
    }
    if (rows.length === MAX_ROWS) appendRowButton.disabled = true;
});
removeRowButton.addEventListener("click", function() {
    if (rows.length > MIN_ROWS) {
        appendRowButton.disabled = false;
        var lastRow = rows[rows.length - 1];
        lastRow.remove();
    }
    if (rows.length === MIN_ROWS) removeRowButton.disabled = true;
});
appendColumnButton.addEventListener("click", function() {
    if (rows[0].cells.length < MAX_COLUMNS) {
        removeColumnButton.disabled = false;
        var arrayRows = Array.from(table.rows);
        arrayRows.forEach(function(row) {
            var newTd = document.createElement("td");
            row.append(newTd);
        });
    }
    if (rows[0].cells.length === MAX_COLUMNS) appendColumnButton.disabled = true;
});
removeColumnButton.addEventListener("click", function() {
    if (rows[0].cells.length > MIN_COLUMNS) {
        appendColumnButton.disabled = false;
        var arrayRows = Array.from(table.rows);
        arrayRows.forEach(function(row) {
            var lastTd = row.cells[row.cells.length - 1];
